{
  "id": "s1",
  "use_case": {
    "id": "personal-assistant",
    "name": "Personal assistant HI system",
    "concept": "PersonalAssistantUseCase",
    "domain": "HealthAndLifestyleDomain"
  },
  "goal": {
    "id": "user-wellbeing",
    "name": "Maintain and improve user wellbeing",
    "concept": "UserWellbeingGoal"
  },
  "context": {
    "concept": "HealthMonitoringContext",
    "phenomena": ["SensorNoisePhenomenon", "DataMismatchPhenomenon", "TrustShiftPhenomenon"],
    "constraints": ["PrivacyConstraint", "AutonomyConstraint", "TransparencyConstraint"],
    "description": "Health-monitoring context involving multimodal data, user reports, and sensor uncertainty."
  },
  "tasks": [
    {
      "id": "data-collection",
      "name": "Collect self-reports and sensor activity data",
      "concept": "DataCollectionTask"
    },
    {
      "id": "conflict-resolution",
      "name": "Resolve inconsistencies between reported and sensed data",
      "concept": "ConflictResolutionTask"
    },
    {
      "id": "explanation",
      "name": "Provide explanations to maintain trust and engagement",
      "concept": "ExplanationTask"
    }
  ],
  "capabilities": [
    {
      "id": "sensing",
      "concept": "SensingCapability",
      "agents": ["ai-assistant"],
      "tasks": ["data-collection"]
    },
    {
      "id": "self-reporting",
      "concept": "SelfReportingCapability",
      "agents": ["human-user"],
      "tasks": ["data-collection"]
    },
    {
      "id": "reasoning",
      "concept": "ReasoningCapability",
      "agents": ["ai-assistant"],
      "tasks": ["conflict-resolution"]
    },
    {
      "id": "explaining",
      "concept": "ExplainingCapability",
      "agents": ["ai-assistant"],
      "tasks": ["explanation"]
    }
  ],
  "executions": [
    {
      "id": "data-collection",
      "concept": "DataCollectionTaskExecution",
      "task": "data-collection",
      "agent": "human-user",
      "method": "DataCollectionMethod"
    },
    {
      "id": "conflict-resolution",
      "concept": "ConflictResolutionTaskExecution",
      "task": "conflict-resolution",
      "agent": "ai-assistant",
      "method": "ArgumentationReasoningMethod"
    },
    {
      "id": "explanation",
      "concept": "ExplanationTaskExecution",
      "task": "explanation",
      "agent": "ai-assistant",
      "method": "PostHocExplanationMethod"
    }
  ],
  "experiments": [
    {
      "id": "data-collection-quality",
      "concept": "TransparencyTrustExperiment",
      "metrics": ["RecommendationRelevanceMetric"],
      "null_hypothesis": "Data collection quality does not improve user outcomes.",
      "alternative_hypothesis": "Better data collection improves personalization and outcomes."
    },
    {
      "id": "conflict-accuracy",
      "concept": "DeliberationSupportExperiment",
      "metrics": ["FairOutcomeMetric"],
      "null_hypothesis": "Conflict resolution does not improve data consistency.",
      "alternative_hypothesis": "Argumentation-based conflict resolution increases consistency."
    },
    {
      "id": "transparency-trust",
      "concept": "TransparencyTrustExperiment",
      "metrics": ["TrustPreservationMetric"],
      "null_hypothesis": "Transparency does not affect trust.",
      "alternative_hypothesis": "Transparency improves user trust."
    }
  ],
  "evaluations": [
    {
      "id": "data-collection-quality",
      "concept": "DataCollectionQualityEvaluation",
      "metrics": ["RecommendationRelevanceMetric"],
      "experiment": "data-collection-quality",
      "executions": ["data-collection"],
      "description": "Evaluates the completeness, reliability, and relevance of collected data."
    },
    {
      "id": "conflict-accuracy",
      "concept": "ConflictResolutionAccuracyEvaluation",
      "metrics": ["FairOutcomeMetric"],
      "experiment": "conflict-accuracy",
      "executions": ["conflict-resolution"],
      "description": "Evaluates how accurately inconsistencies are identified and resolved."
    },
    {
      "id": "transparency-impact",
      "concept": "TransparencyEvaluation",
      "metrics": ["TrustPreservationMetric"],
      "experiment": "transparency-trust",
      "executions": ["explanation"],
      "description": "Evaluates how explanation clarity influences user trust under inconsistent data."
    }
  ],
  "agents": [
    {
      "id": "human-user",
      "name": "Human user",
      "kind": "human",
      "roles": ["HumanUserRole"]
    },
    {
      "id": "ai-assistant",
      "name": "AI assistant",
      "kind": "artificial",
      "roles": ["AIAssistantRole"]
    }
  ]
}

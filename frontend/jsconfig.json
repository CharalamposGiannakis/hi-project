{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "resolveJsonModule": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.js", "src/**/*.svelte", "integration/**/*.js"]
}
